<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8FAFC"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Judul Aplikasi -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Logistics Tracker"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lacak posisi paket &amp; kiriman barang real-time"
            android:textSize="13sp"
            android:textColor="#64748B"
            android:layout_marginBottom="16dp" />

        <!-- Form Input Nomor Resi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/editTextTrackingNumber"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:hint="Masukkan No Resi (cth: EXP-8801)"
                android:inputType="textCapCharacters"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_input_resi"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />

            <Button
                android:id="@+id/buttonTrack"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:text="Lacak"
                android:textStyle="bold"
                android:backgroundTint="#0D9488"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Pilihan Contoh Resi Cepat untuk Uji Coba -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pilih contoh resi cepat:"
            android:textSize="12sp"
            android:textColor="#64748B"
            android:layout_marginBottom="6dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnQuickResi1"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:text="EXP-8801"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnQuickResi2"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:text="EXP-8802"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnQuickResi3"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:text="EXP-8803"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnQuickResi4"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:text="EXP-8804"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnQuickResi5"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:text="EXP-8805"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnQuickResi404"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:text="EXP-9999 (404)"
                    android:textColor="#DC2626"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Indikator Loading (ProgressBar) -->
        <ProgressBar
            android:id="@+id/progressBarLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginVertical="16dp" />

        <!-- Error Message TextView -->
        <TextView
            android:id="@+id/textViewErrorMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#DC2626"
            android:textSize="14sp"
            android:visibility="gone"
            android:padding="12dp"
            android:background="@drawable/bg_error_box"
            android:layout_marginBottom="16dp" />

        <!-- Result Card (CardView) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/textViewResiTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Resi: -"
                        android:textStyle="bold"
                        android:textSize="17sp"
                        android:textColor="#0F172A" />

                    <!-- Badge Status Pengiriman -->
                    <TextView
                        android:id="@+id/textViewStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="STATUS"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/textViewCourier"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kurir: -"
                    android:textSize="14sp"
                    android:textColor="#334155"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/textViewLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Posisi Terakhir: -"
                    android:textSize="14sp"
                    android:textColor="#334155"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/textViewRecipient"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Penerima: -"
                    android:textSize="14sp"
                    android:textColor="#334155"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/textViewEta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Estimasi Tiba: -"
                    android:textSize="14sp"
                    android:textColor="#334155" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>